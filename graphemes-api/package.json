{
  "name": "graphemes-api",
  "version": "0.0.1",
  "description": "API for graphemes register",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start:dev": "nodemon --watch src --ext ts --exec node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "format": "npx prettier . --write",
    "lint": "npx eslint .",
    "test": "npx vitest"
  },
  "dependencies": {
    "any-ascii": "0.3.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "js-levenshtein-esm": "2.0.0",
    "knex": "3.2.10",
    "pg": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "25.9.1",
    "@types/supertest": "7.2.0",
    "eslint": "9.39.4",
    "globals": "17.6.0",
    "nodemon": "3.1.14",
    "prettier": "3.8.3",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.39.1",
    "vitest": "4.1.8"
  }
}
