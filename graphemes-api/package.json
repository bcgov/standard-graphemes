{
  "name": "graphemes-api",
  "version": "0.0.1",
  "description": "API for graphemes register",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start:dev": "nodemon --watch src --ext ts --exec node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "format": "npx prettier . --write",
    "lint": "npx eslint .",
    "test": "npx vitest"
  },
  "dependencies": {
    "any-ascii": "0.3.3",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "js-levenshtein-esm": "2.0.0",
    "knex": "3.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
